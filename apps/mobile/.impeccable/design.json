    {
      "name": "Instruction Card",
      "kind": "card",
      "description": "Flat native surface card with numbered, flexible instructions.",
      "html": "<section class=\"ds-card\" aria-label=\"ECG preparation\"><p class=\"ds-step\"><span class=\"ds-step-number\">1</span><span>Sit comfortably and keep still.</span></p><p class=\"ds-step\"><span class=\"ds-step-number\">2</span><span>Use the electrode position described in your BP2 instructions.</span></p><p class=\"ds-step\"><span class=\"ds-step-number\">3</span><span>Press the ECG function button on the BP2 and record for 30 seconds.</span></p></section>",
      "css": ".ds-card{max-width:342px;background:#FFFFFF;color:#24202D;border-radius:16px;padding:22px;font:400 17px/24px -apple-system,BlinkMacSystemFont,system-ui,sans-serif;} .ds-step{display:flex;gap:14px;margin:0 0 20px;} .ds-step:last-child{margin-bottom:0;} .ds-step-number{color:#694D98;font-weight:600;} @media(prefers-color-scheme:dark){.ds-card{background:#24202D;color:#F5F1FA;} .ds-step-number{color:#C8A9F5;}}",
      "refersTo": "card"
    },
    {
      "name": "Ruled Device Row",
      "kind": "custom",
