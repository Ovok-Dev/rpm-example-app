      "html": "<div class=\"ds-filters\" aria-label=\"Diary filters\"><button class=\"ds-filter\" type=\"button\" aria-pressed=\"true\">All</button><button class=\"ds-filter\" type=\"button\" aria-pressed=\"false\">ECG</button><button class=\"ds-filter\" type=\"button\" aria-pressed=\"false\">Weight</button><button class=\"ds-filter\" type=\"button\" aria-pressed=\"false\">Questionnaire</button></div>",
      "css": ".ds-filters{display:flex;gap:8px;overflow-x:auto;max-width:390px;} .ds-filter{flex-shrink:0;border:0;border-radius:10px;min-height:44px;padding:0 16px;background:#FFFFFF;color:#6B6476;font:600 14px/24px -apple-system,BlinkMacSystemFont,system-ui,sans-serif;cursor:pointer;} .ds-filter[aria-pressed=\"true\"]{background:#694D98;color:#F8F7FA;} .ds-filter:hover,.ds-filter:active{opacity:.8;} .ds-filter:focus-visible{outline:2px solid #694D98;outline-offset:-2px;} @media(prefers-color-scheme:dark){.ds-filter{background:#24202D;color:#B4ABBE;} .ds-filter[aria-pressed=\"true\"]{background:#C8A9F5;color:#17141D;} .ds-filter:focus-visible{outline-color:#C8A9F5;}}",
