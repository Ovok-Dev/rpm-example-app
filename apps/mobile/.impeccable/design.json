      "html": "<button class=\"ds-row\" type=\"button\"><svg aria-hidden=\"true\" width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2 12h4l2-7 4 14 3-10 2 3h5\"/></svg><span class=\"ds-row-copy\"><span class=\"ds-row-title\">Viatom BP2</span><span class=\"ds-row-detail\">ECG monitor \u00b7 Instructions for use</span></span><svg class=\"ds-chevron\" aria-hidden=\"true\" width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 5 7 7-7 7\"/></svg></button>",
      "css": ".ds-row{display:flex;align-items:center;gap:14px;min-height:76px;max-width:390px;width:100%;padding:16px 0;border:0;border-bottom:.5px solid #E8E3EC;background:transparent;color:#694D98;text-align:left;cursor:pointer;} .ds-row-copy{flex:1;display:flex;flex-direction:column;gap:4px;} .ds-row-title{color:#24202D;font:500 17px/24px -apple-system,BlinkMacSystemFont,system-ui,sans-serif;} .ds-row-detail{color:#6B6476;font:400 14px/24px -apple-system,BlinkMacSystemFont,system-ui,sans-serif;} .ds-chevron{width:13px;height:13px;color:#6B6476;} .ds-row:hover,.ds-row:active{opacity:.6;} .ds-row:focus-visible{outline:2px solid #694D98;outline-offset:2px;} @media(prefers-color-scheme:dark){.ds-row{color:#C8A9F5;border-color:#393140;} .ds-row-title{color:#F5F1FA;} .ds-row-detail,.ds-chevron{color:#B4ABBE;} .ds-row:focus-visible{outline-color:#C8A9F5;}}",
      "refersTo": "row"
    },
    {
      "name": "Next-task Panel",
      "kind": "custom",
      "description": "Initial daily panel with a named task and three-step progress. Static preview; the native app advances the action and removes it when complete.",
      "html": "<section class=\"ds-care\"><h2 class=\"ds-care-title\">A little care.<br>Every day.</h2><p class=\"ds-care-copy\">Your daily check-in, one step at a time.</p><div class=\"ds-progress\" aria-label=\"0 of 3 daily tasks recorded\"><span class=\"ds-progress-bar\"></span><span class=\"ds-progress-bar\"></span><span class=\"ds-progress-bar\"></span><span class=\"ds-progress-label\">0 of 3</span></div><button class=\"ds-next-task\" type=\"button\"><span>Record your ECG</span><svg aria-hidden=\"true\" width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></button></section>",
      "css": ".ds-care{max-width:342px;padding:24px;border-radius:16px;background:#4B356D;color:#FFFFFF;font:400 17px/24px -apple-system,BlinkMacSystemFont,system-ui,sans-serif;} .ds-care-title{margin:0 0 17px;font-size:28px;line-height:34px;font-weight:600;letter-spacing:-.6px;} .ds-care-copy{margin:0 0 17px;color:#DDD1ED;} .ds-progress{display:flex;align-items:center;gap:7px;margin-bottom:17px;} .ds-progress-bar{flex:1;height:4px;border-radius:2px;background:#7D669B;} .ds-progress-label{margin-left:6px;color:#DDD1ED;font-size:13px;} .ds-next-task{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:49px;padding:12px 16px;border:0;border-radius:10px;background:#FFFFFF;color:#4B356D;font:600 17px/24px -apple-system,BlinkMacSystemFont,system-ui,sans-serif;text-align:left;cursor:pointer;} .ds-next-task:hover,.ds-next-task:active{opacity:.85;} .ds-next-task:focus-visible{outline:2px solid #DDD1ED;outline-offset:3px;}",
      "refersTo": "next-task-panel"
    },
