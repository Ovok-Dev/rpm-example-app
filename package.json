{
  "name": "ovok-rpm-example-app",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "mobile": "turbo run dev --filter=ovok-rpm-example",
    "dashboard": "turbo run dev --filter=ovok-rpm-clinician-dashboard",
    "ehr": "turbo run dev --filter=ovok-ehr-example",
    "dev:ehr": "turbo run dev --filter=ovok-ehr-example",
    "ios": "turbo run ios --filter=ovok-rpm-example",
    "android": "turbo run android --filter=ovok-rpm-example",
    "preview:dashboard": "turbo run preview --filter=ovok-rpm-clinician-dashboard",
    "preview:ehr": "turbo run preview --filter=ovok-ehr-example",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build bundle",
    "check": "turbo run typecheck test expo-check build bundle"
  },
  "devDependencies": {
    "turbo": "2.11.7"
  }
}
